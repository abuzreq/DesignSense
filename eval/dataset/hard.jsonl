{"id": "H065", "tier": "hard", "dataset": "massing", "utterance": "color by cost, put FAR on x and sDa on y", "gold": {"command": "sequence", "args": {"steps": [{"command": "view.color", "args": {"dim": "out:Cost"}}, {"command": "view.axes", "args": {"x": "out:FAR", "y": "out:sDa(%)"}}]}}, "strata": {"entity": "abbreviation", "clauses": 2, "context": false, "note": "three columns, two commands, one utterance"}, "source": "seed"}
{"id": "H066", "tier": "hard", "dataset": "used_cars", "utterance": "undo, then clear the filters and start from the full set", "gold": {"command": "sequence", "args": {"steps": [{"command": "history.undo", "args": {}}, {"command": "filter.clear", "args": {}}, {"command": "scope.reset", "args": {}}]}}, "strata": {"entity": "none", "clauses": 3, "context": true}, "source": "seed"}
{"id": "H067", "tier": "hard", "dataset": "windows", "utterance": "how many match depth = 9", "gold": {"command": "ask.count", "args": {"where": [{"dim": "in:Depth [ft]", "op": "eq", "value": 9}]}}, "strata": {"entity": "exact", "clauses": 1, "context": false, "note": "reported by the user: depth is the name of in:Depth and an alias of out:EffDepth; the name must win, and a count with a condition must not silently drop it"}, "source": "user"}
{"id": "H068", "tier": "hard", "dataset": "windows", "utterance": "which has the highest cooling and heating", "gold": {"command": "sequence", "args": {"steps": [{"command": "ask.extreme", "args": {"dim": "out:Cooling[kWh]", "direction": "max"}}, {"command": "ask.extreme", "args": {"dim": "out:Heating[kWh]", "direction": "max"}}]}}, "strata": {"entity": "exact", "clauses": 2, "context": false, "note": "reported by the user: two columns in one question are two questions, not an ambiguity"}, "source": "user"}
{"id": "H069", "tier": "hard", "dataset": "used_cars", "utterance": "exclude cylinders =0", "gold": {"command": "filter.range", "args": {"dim": "cylinders", "op": "ne", "value": 0}}, "strata": {"entity": "exact", "clauses": 1, "context": false, "note": "reported by the user: exclude with = is not-equal, and =0 has no space"}, "source": "user"}
{"id": "H070", "tier": "hard", "dataset": "used_cars", "utterance": "cluster into five groups", "gold": {"command": "analysis.cluster", "args": {"k": 5}}, "strata": {"entity": "none", "clauses": 1, "context": false, "note": "a count said as a word"}, "source": "user"}
{"id": "H071", "tier": "hard", "dataset": "used_cars", "utterance": "invert selection", "gold": {"command": "select.invert", "args": {}}, "strata": {"entity": "none", "clauses": 1, "context": true, "note": "reported by the user; the regex for this had a literal backspace byte in it"}, "source": "user"}
{"id": "H072", "tier": "hard", "dataset": "windows", "utterance": "select highest cooling", "gold": {"command": "filter.percentile", "args": {"dim": "out:Cooling[kWh]", "percent": 10, "direction": "top"}}, "strata": {"entity": "exact", "clauses": 1, "context": false, "note": "reported by the user: selecting the highest is narrowing to a band, not inspecting one option; asking is 'which'"}, "source": "user"}
{"id": "H073", "tier": "hard", "dataset": "used_cars", "utterance": "select the cheapest", "gold": {"command": "filter.percentile", "args": {"dim": "price", "percent": 10, "direction": "bottom"}}, "strata": {"entity": "synonym", "clauses": 1, "context": false, "note": "cheapest names price through the alias table"}, "source": "user"}
{"id": "H074", "tier": "hard", "dataset": "used_cars", "utterance": "price under 5000 or over 20000", "gold": {"command": "filter.range", "args": {"dim": "price", "op": "any", "clauses": [{"op": "lte", "value": 5000}, {"op": "gte", "value": 20000}]}}, "strata": {"entity": "exact", "clauses": 1, "context": false, "note": "asked for by the user: an or on one column is one filter with two brushes"}, "source": "user"}
{"id": "H075", "tier": "hard", "dataset": "used_cars", "utterance": "year between 2004 and 2012 or between 1990 and 2000", "gold": {"command": "filter.range", "args": {"dim": "year", "op": "any", "clauses": [{"op": "between", "range": [2004, 2012]}, {"op": "between", "range": [1990, 2000]}]}}, "strata": {"entity": "exact", "clauses": 1, "context": false, "note": "two ranges on one column; the and inside each between must not split the sentence"}, "source": "user"}
{"id": "H076", "tier": "hard", "dataset": "used_cars", "utterance": "price under 5000 or year over 2010", "gold": {"command": "abstain", "args": {"reason": "unsupported"}}, "strata": {"entity": "exact", "clauses": 2, "context": false, "note": "an or across two columns is not one filter; applying both as an and would be wrong"}, "source": "user"}
{"id": "H077", "tier": "hard", "dataset": "used_cars", "utterance": "exclude price under 5000 or over 20000", "gold": {"command": "filter.range", "args": {"dim": "price", "op": "between", "range": [5000, 20000]}}, "strata": {"entity": "exact", "clauses": 1, "context": false, "note": "excluding an or keeps the middle: the negation is an and"}, "source": "user"}
{"id": "H078", "tier": "hard", "dataset": "used_cars", "utterance": "year 2000 or above", "gold": {"command": "filter.range", "args": {"dim": "year", "op": "gte", "value": 2000}}, "strata": {"entity": "exact", "clauses": 1, "context": false, "note": "an or that introduces no second comparison is part of the clause"}, "source": "user"}
